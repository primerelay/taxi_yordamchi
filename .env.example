# my.telegram.org -> API development tools dan olinadi
API_ID=1234567
API_HASH=your_api_hash_here

# @BotFather dan olinadi (boshqaruvchi bot tokeni)
BOT_TOKEN=123456:ABC-DEF...

# Ma'lumotlar bazasi fayli
DB_PATH=taxi_bot.db

# Xavfsizlik: minimal interval (daqiqa). Juda kichik qilsangiz akkaunt bloklanishi mumkin.
MIN_INTERVAL_MINUTES=5

# Har bir guruhga yuborish orasidagi kechikish (sekund) — flud himoyasi
SEND_DELAY_SECONDS=4

# Yangi foydalanuvchiga bepul sinov kunlari
TRIAL_DAYS=3
# To'lov uchun bog'lanadigan admin username
SUPPORT_USERNAME=@admin

# ---- Admin panel ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
# Sessiya cookie imzolash uchun maxfiy kalit (uzun tasodifiy satr qo'ying)
ADMIN_SECRET_KEY=please-change-this-to-a-long-random-string
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8000
# To'lov valyutasi (faqat ko'rsatish uchun)
CURRENCY=so'm
