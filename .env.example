# my.telegram.org -> API development tools dan olinadi
API_ID=1234567
API_HASH=your_api_hash_here

# @BotFather dan olinadi (boshqaruvchi bot tokeni)
BOT_TOKEN=123456:ABC-DEF...

# Ma'lumotlar bazasi fayli
DB_PATH=taxi_bot.db

# Xavfsizlik: minimal interval (soniya). Juda kichik qilsangiz akkaunt bloklanishi mumkin.
MIN_INTERVAL_SECONDS=30

# Har bir guruhga yuborish orasidagi kechikish (sekund) — flud himoyasi
SEND_DELAY_SECONDS=4

# Yangi foydalanuvchiga bepul sinov kunlari
TRIAL_DAYS=3
# Do'st taklif qilgani uchun bonus kunlar
REFERRAL_DAYS=3
# To'lov uchun bog'lanadigan admin username
SUPPORT_USERNAME=@admin
# Broadcast yubora oladigan adminlar Telegram ID (vergul bilan): 123,456
ADMIN_IDS=

# ---- Admin guruh (yangi buyruqlar shu yerda ishlaydi) ----
# /elon, /kunlik, /add_days, /help FAQAT shu guruhda ishlaydi; kunlik hisobot ham shu yerga tushadi.
# Guruh id manfiy bo'ladi. Uni bilish uchun botni guruhga qo'shib, guruhda /id yozing.
# MUHIM: @BotFather -> /setprivacy -> Disable qiling (bot oddiy xabarlarni ko'rishi uchun).
ADMIN_GROUP_ID=
# Kunlik hisobot vaqti (soat, Toshkent) va top ro'yxat uzunligi
REPORT_HOUR=9
REPORT_TOP_N=50
TIMEZONE=Asia/Tashkent

# ---- Admin panel ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
# Sessiya cookie imzolash uchun maxfiy kalit (uzun tasodifiy satr qo'ying)
ADMIN_SECRET_KEY=please-change-this-to-a-long-random-string
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8000
# To'lov valyutasi (faqat ko'rsatish uchun)
CURRENCY=so'm
